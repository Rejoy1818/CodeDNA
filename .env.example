# CodeDNA Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Flask Secret Key (required for sessions, CSRF protection)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# Flask Environment
FLASK_ENV=production
FLASK_DEBUG=false

# GitHub API Token (optional, for higher API rate limits)
GITHUB_TOKEN=your_github_token_here

# API Keys for authentication (comma-separated: key:role pairs)
# Example: admin-key-123:admin,user-key-456:user
API_KEYS=admin-key-123:admin,user-key-456:user

# CORS Allowed Origin (frontend URL)
CORS_ORIGIN=http://localhost:4200

# Database URL
CODEDNA_DB=sqlite:///codedna.db

# Rate Limiting Storage (use redis:// for production)
RATELIMIT_STORAGE_URL=memory://

# Maximum code size for classification (bytes)
MAX_CODE_SIZE=65536

# Maximum commits to collect per request
MAX_COMMITS_LIMIT=1000